        <dc:Bounds x="1379" y="150" width="155" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ProceedAlloc_shape" bpmnElement="GW_ProceedAlloc" isMarkerVisible="true">
