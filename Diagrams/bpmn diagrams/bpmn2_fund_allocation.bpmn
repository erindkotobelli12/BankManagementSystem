          <dc:Bounds x="193" y="198" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenDashboard_shape" bpmnElement="Task_OpenDashboard">
