          <dc:Bounds x="1530" y="200" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ViewOnly_shape" bpmnElement="End_ViewOnly">
        <dc:Bounds x="1714" y="171" width="30" height="30" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1694" y="206" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_AllocOrRedist_shape" bpmnElement="GW_AllocOrRedist" isMarkerVisible="true">
        <dc:Bounds x="375" y="413" width="32" height="32" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="307" y="416" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectTarget_shape" bpmnElement="Task_SelectTarget">
        <dc:Bounds x="425" y="375" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectSource_shape" bpmnElement="Task_SelectSource">
        <dc:Bounds x="425" y="453" width="140" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectDest_shape" bpmnElement="Task_SelectDest">
        <dc:Bounds x="583" y="453" width="155" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_UnitsMerge_shape" bpmnElement="GW_UnitsMerge" isMarkerVisible="true">
        <dc:Bounds x="758" y="413" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterAmount_shape" bpmnElement="Task_EnterAmount">
        <dc:Bounds x="810" y="401" width="140" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewConfirm_shape" bpmnElement="Task_ReviewConfirm">
        <dc:Bounds x="970" y="401" width="145" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitAlloc_shape" bpmnElement="Task_SubmitAlloc">
        <dc:Bounds x="1135" y="401" width="145" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EBG_AwaitResponse_shape" bpmnElement="EBG_AwaitResponse">
        <dc:Bounds x="1300" y="413" width="32" height="32" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1341.5" y="422" width="79" height="14" />
        </bpmndi:BPMNLabel>
