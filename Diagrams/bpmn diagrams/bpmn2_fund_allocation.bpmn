<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BMS_FundAllocation" targetNamespace="http://bms.example.com/bpmn/fund-allocation" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collab_FundAllocation">
    <participant id="Pool_Director" name="Bank Director" processRef="Proc_Director" />
    <participant id="Pool_BankingSystem" name="Banking System" processRef="Proc_BankingSystem" />
    <participant id="Pool_TargetBranch" name="Target Branch / ATM Unit" processRef="Proc_TargetBranch" />
    <messageFlow id="MF_AllocRequest" name="Allocation Request" sourceRef="Task_SubmitAlloc" targetRef="IntCatch_ReceiveAlloc" />
    <messageFlow id="MF_ErrorNotice" name="Validation Error" sourceRef="Task_NotifyError" targetRef="IntCatch_Error" />
    <messageFlow id="MF_QueuedNotice" name="Queued" sourceRef="Task_QueueNotify" targetRef="IntCatch_Queued" />
    <messageFlow id="MF_Confirmed" name="Confirmed" sourceRef="Task_UpdateBalancesConfirm" targetRef="IntCatch_Confirmed" />
    <messageFlow id="MF_FundTransfer" name="Fund Transfer" sourceRef="Task_DebitCredit" targetRef="IntCatch_ReceiveTransfer" />
  </collaboration>
  <process id="Proc_Director" name="Bank Director" isExecutable="false">
    <startEvent id="Start_DirectorAuth" name="Director Authenticated (BS_UM_02)">
      <outgoing>SF_D_01</outgoing>
    </startEvent>
    <task id="Task_OpenDashboard" name="Open Funds Dashboard">
      <incoming>SF_D_01</incoming>
      <outgoing>SF_D_02</outgoing>
    </task>
    <task id="Task_SelectAllocView" name="Select Fund Allocations &#38; Balances View">
      <incoming>SF_D_02</incoming>
      <outgoing>SF_D_03</outgoing>
    </task>
    <exclusiveGateway id="GW_BranchOrATM" name="View Branch or ATM?">
      <incoming>SF_D_03</incoming>
      <outgoing>SF_D_04a</outgoing>
      <outgoing>SF_D_04b</outgoing>
    </exclusiveGateway>
    <task id="Task_SelectBranch" name="Select Branch or Region">
      <incoming>SF_D_04a</incoming>
      <outgoing>SF_D_05a</outgoing>
    </task>
    <task id="Task_SelectATM" name="Select ATM Unit">
      <incoming>SF_D_04b</incoming>
      <outgoing>SF_D_05b</outgoing>
    </task>
    <exclusiveGateway id="GW_SelectionMerge" name="">
      <incoming>SF_D_05a</incoming>
      <incoming>SF_D_05b</incoming>
      <outgoing>SF_D_06</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_OutsideScope" name="Branch/ATM Outside Assigned Scope?">
      <incoming>SF_D_06</incoming>
      <outgoing>SF_D_07a</outgoing>
      <outgoing>SF_D_07b</outgoing>
    </exclusiveGateway>
    <task id="Task_RetrieveBalances" name="System Retrieves Fund Balances &#38; Allocations">
      <incoming>SF_D_07b</incoming>
      <outgoing>SF_D_09</outgoing>
    </task>
    <exclusiveGateway id="GW_DataAvail" name="Data Available?">
      <incoming>SF_D_09</incoming>
      <outgoing>SF_D_10a</outgoing>
      <outgoing>SF_D_10b</outgoing>
    </exclusiveGateway>
    <task id="Task_DisplaySummary" name="Display Allocation Summary Dashboard">
      <incoming>SF_D_10a</incoming>
      <outgoing>SF_D_11a</outgoing>
    </task>
    <task id="Task_DataPending" name="Show &#34;Data Pending&#34; Indicator">
      <incoming>SF_D_10b</incoming>
      <outgoing>SF_D_11b</outgoing>
    </task>
    <exclusiveGateway id="GW_DataMerge" name="">
      <incoming>SF_D_11a</incoming>
      <incoming>SF_D_11b</incoming>
      <outgoing>SF_D_12</outgoing>
    </exclusiveGateway>
    <task id="Task_LogAccess" name="Log Access Event in Audit Trail">
      <incoming>SF_D_12</incoming>
      <outgoing>SF_D_13</outgoing>
    </task>
    <exclusiveGateway id="GW_ProceedAlloc" name="Proceed to Allocation?">
      <incoming>SF_D_13</incoming>
      <outgoing>SF_D_14a</outgoing>
      <outgoing>SF_D_14b</outgoing>
    </exclusiveGateway>
    <endEvent id="End_ViewOnly" name="Viewing Complete">
      <incoming>SF_D_14a</incoming>
    </endEvent>
    <exclusiveGateway id="GW_AllocOrRedist" name="Allocate or Redistribute?">
      <incoming>SF_D_14b</incoming>
      <outgoing>SF_D_15a</outgoing>
      <outgoing>SF_D_15b</outgoing>
    </exclusiveGateway>
    <task id="Task_SelectTarget" name="Select Target Unit (Central Reserve as Source)">
      <incoming>SF_D_15a</incoming>
      <outgoing>SF_D_16a</outgoing>
    </task>
    <task id="Task_SelectSource" name="Select Source Unit">
      <incoming>SF_D_15b</incoming>
      <outgoing>SF_D_16b</outgoing>
    </task>
    <task id="Task_SelectDest" name="Select Destination Unit">
      <incoming>SF_D_16b</incoming>
      <outgoing>SF_D_17b</outgoing>
    </task>
    <exclusiveGateway id="GW_UnitsMerge" name="">
      <incoming>SF_D_16a</incoming>
      <incoming>SF_D_17b</incoming>
      <outgoing>SF_D_18</outgoing>
    </exclusiveGateway>
    <task id="Task_EnterAmount" name="Enter Transfer Amount">
      <incoming>SF_D_18</incoming>
      <incoming>Flow_15sl48z</incoming>
      <outgoing>SF_D_19</outgoing>
    </task>
    <task id="Task_ReviewConfirm" name="Review &#38; Confirm Details">
      <incoming>SF_D_19</incoming>
      <outgoing>SF_D_20</outgoing>
    </task>
    <task id="Task_SubmitAlloc" name="Submit Allocation Request">
      <incoming>SF_D_20</incoming>
      <outgoing>SF_D_21</outgoing>
    </task>
    <eventBasedGateway id="EBG_AwaitResponse" name="Await Response">
      <incoming>SF_D_21</incoming>
      <outgoing>SF_D_22a</outgoing>
      <outgoing>SF_D_22b</outgoing>
      <outgoing>SF_D_22c</outgoing>
    </eventBasedGateway>
    <exclusiveGateway id="GW_Retry" name="Retry?">
      <incoming>SF_D_23c</incoming>
      <outgoing>SF_D_RetryYes</outgoing>
      <outgoing>SF_D_RetryNo</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SF_D_01" sourceRef="Start_DirectorAuth" targetRef="Task_OpenDashboard" />
    <sequenceFlow id="SF_D_02" sourceRef="Task_OpenDashboard" targetRef="Task_SelectAllocView" />
    <sequenceFlow id="SF_D_03" sourceRef="Task_SelectAllocView" targetRef="GW_BranchOrATM" />
    <sequenceFlow id="SF_D_04a" name="Branch" sourceRef="GW_BranchOrATM" targetRef="Task_SelectBranch" />
    <sequenceFlow id="SF_D_04b" name="ATM" sourceRef="GW_BranchOrATM" targetRef="Task_SelectATM" />
    <sequenceFlow id="SF_D_05a" sourceRef="Task_SelectBranch" targetRef="GW_SelectionMerge" />
    <sequenceFlow id="SF_D_05b" sourceRef="Task_SelectATM" targetRef="GW_SelectionMerge" />
    <sequenceFlow id="SF_D_06" sourceRef="GW_SelectionMerge" targetRef="GW_OutsideScope" />
    <sequenceFlow id="SF_D_07a" name="Yes" sourceRef="GW_OutsideScope" targetRef="Task_DenyAccess" />
    <sequenceFlow id="SF_D_07b" name="No" sourceRef="GW_OutsideScope" targetRef="Task_RetrieveBalances" />
    <sequenceFlow id="SF_D_08a" sourceRef="Task_DenyAccess" targetRef="End_AccessDenied" />
    <sequenceFlow id="SF_D_09" sourceRef="Task_RetrieveBalances" targetRef="GW_DataAvail" />
    <sequenceFlow id="SF_D_10a" name="Yes" sourceRef="GW_DataAvail" targetRef="Task_DisplaySummary" />
    <sequenceFlow id="SF_D_10b" name="No" sourceRef="GW_DataAvail" targetRef="Task_DataPending" />
    <sequenceFlow id="SF_D_11a" sourceRef="Task_DisplaySummary" targetRef="GW_DataMerge" />
    <sequenceFlow id="SF_D_11b" sourceRef="Task_DataPending" targetRef="GW_DataMerge" />
    <sequenceFlow id="SF_D_12" sourceRef="GW_DataMerge" targetRef="Task_LogAccess" />
    <sequenceFlow id="SF_D_13" sourceRef="Task_LogAccess" targetRef="GW_ProceedAlloc" />
    <sequenceFlow id="SF_D_14a" name="No - View Only" sourceRef="GW_ProceedAlloc" targetRef="End_ViewOnly" />
    <sequenceFlow id="SF_D_14b" name="Yes - Allocate" sourceRef="GW_ProceedAlloc" targetRef="GW_AllocOrRedist" />
    <sequenceFlow id="SF_D_15a" name="Allocate" sourceRef="GW_AllocOrRedist" targetRef="Task_SelectTarget" />
    <sequenceFlow id="SF_D_15b" name="Redistribute" sourceRef="GW_AllocOrRedist" targetRef="Task_SelectSource" />
    <sequenceFlow id="SF_D_16a" sourceRef="Task_SelectTarget" targetRef="GW_UnitsMerge" />
    <sequenceFlow id="SF_D_16b" sourceRef="Task_SelectSource" targetRef="Task_SelectDest" />
    <sequenceFlow id="SF_D_17b" sourceRef="Task_SelectDest" targetRef="GW_UnitsMerge" />
    <sequenceFlow id="SF_D_18" sourceRef="GW_UnitsMerge" targetRef="Task_EnterAmount" />
    <sequenceFlow id="SF_D_19" sourceRef="Task_EnterAmount" targetRef="Task_ReviewConfirm" />
    <sequenceFlow id="SF_D_20" sourceRef="Task_ReviewConfirm" targetRef="Task_SubmitAlloc" />
    <sequenceFlow id="SF_D_21" sourceRef="Task_SubmitAlloc" targetRef="EBG_AwaitResponse" />
    <sequenceFlow id="SF_D_22a" name="Confirmed" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_Confirmed" />
    <sequenceFlow id="SF_D_22b" name="Queued" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_Queued" />
    <sequenceFlow id="SF_D_22c" name="Error" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_Error" />
    <sequenceFlow id="SF_D_23a" sourceRef="IntCatch_Confirmed" targetRef="End_AllocComplete" />
    <sequenceFlow id="SF_D_23b" sourceRef="IntCatch_Queued" targetRef="End_UnitOffline" />
    <sequenceFlow id="SF_D_23c" sourceRef="IntCatch_Error" targetRef="GW_Retry" />
    <sequenceFlow id="SF_D_RetryYes" name="Yes - Adjust" sourceRef="GW_Retry" targetRef="IntCatch_Queued" />
    <sequenceFlow id="SF_D_RetryNo" name="No - Cancel" sourceRef="GW_Retry" targetRef="End_Cancelled" />
    <endEvent id="End_AllocComplete" name="Allocation Complete">
      <incoming>SF_D_23a</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntCatch_Confirmed" name="Allocation Confirmed">
      <incoming>SF_D_22a</incoming>
      <outgoing>SF_D_23a</outgoing>
      <messageEventDefinition id="MED_Confirmed" />
    </intermediateCatchEvent>
    <endEvent id="End_UnitOffline" name="Unit Offline - Queued">
      <incoming>SF_D_23b</incoming>
    </endEvent>
    <sequenceFlow id="Flow_15sl48z" sourceRef="IntCatch_Queued" targetRef="Task_EnterAmount" />
    <intermediateCatchEvent id="IntCatch_Error" name="Error Notification">
      <incoming>SF_D_22c</incoming>
      <outgoing>SF_D_23c</outgoing>
      <messageEventDefinition id="MED_Error" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="IntCatch_Queued" name="Queue Notification">
      <incoming>SF_D_22b</incoming>
      <incoming>SF_D_RetryYes</incoming>
      <outgoing>SF_D_23b</outgoing>
      <outgoing>Flow_15sl48z</outgoing>
      <messageEventDefinition id="MED_Queued" />
    </intermediateCatchEvent>
    <endEvent id="End_Cancelled" name="Cancelled">
      <incoming>SF_D_RetryNo</incoming>
    </endEvent>
    <task id="Task_DenyAccess" name="Deny Access &#38; Display Authorization Message">
      <incoming>SF_D_07a</incoming>
      <outgoing>SF_D_08a</outgoing>
    </task>
    <endEvent id="End_AccessDenied" name="Access Denied">
      <incoming>SF_D_08a</incoming>
    </endEvent>
  </process>
  <process id="Proc_BankingSystem" name="Banking System" isExecutable="false">
    <exclusiveGateway id="GW_Valid" name="Valid?">
      <incoming>SF_S_02</incoming>
      <outgoing>SF_S_03a</outgoing>
      <outgoing>SF_S_03b</outgoing>
    </exclusiveGateway>
    <task id="Task_NotifyError" name="Notify Director: Validation Error">
      <incoming>SF_S_03b</incoming>
      <outgoing>SF_S_04b</outgoing>
    </task>
    <endEvent id="End_AllocBlocked" name="Allocation Blocked">
      <incoming>SF_S_04b</incoming>
    </endEvent>
    <task id="Task_CheckOnline" name="Check Target Unit Online?">
      <incoming>SF_S_03a</incoming>
      <outgoing>SF_S_05</outgoing>
    </task>
    <sequenceFlow id="SF_S_01" sourceRef="IntCatch_ReceiveAlloc" targetRef="Task_ValidateBPL" />
    <sequenceFlow id="SF_S_02" sourceRef="Task_ValidateBPL" targetRef="GW_Valid" />
    <sequenceFlow id="SF_S_03a" name="Valid" sourceRef="GW_Valid" targetRef="Task_CheckOnline" />
    <sequenceFlow id="SF_S_03b" name="Invalid" sourceRef="GW_Valid" targetRef="Task_NotifyError" />
    <sequenceFlow id="SF_S_04b" sourceRef="Task_NotifyError" targetRef="End_AllocBlocked" />
    <sequenceFlow id="SF_S_05" sourceRef="Task_CheckOnline" targetRef="GW_Online" />
    <sequenceFlow id="SF_S_06a" name="Yes" sourceRef="GW_Online" targetRef="Task_DebitCredit" />
    <sequenceFlow id="SF_S_06b" name="No" sourceRef="GW_Online" targetRef="Task_QueueNotify" />
    <sequenceFlow id="SF_S_07b" sourceRef="Task_QueueNotify" targetRef="End_SysQueued" />
    <sequenceFlow id="SF_S_08" sourceRef="Task_DebitCredit" targetRef="Task_LogAudit" />
    <sequenceFlow id="SF_S_09" sourceRef="Task_LogAudit" targetRef="Task_UpdateBalancesConfirm" />
    <sequenceFlow id="SF_S_10" sourceRef="Task_UpdateBalancesConfirm" targetRef="End_TransferComplete" />
    <endEvent id="End_TransferComplete" name="Transfer Complete">
      <incoming>SF_S_10</incoming>
    </endEvent>
    <task id="Task_UpdateBalancesConfirm" name="Update Balances in Real Time &#38; Send Confirmation">
      <incoming>SF_S_09</incoming>
      <outgoing>SF_S_10</outgoing>
    </task>
    <task id="Task_LogAudit" name="Log Audit Trail Entry (Director ID, Timestamp, Details)">
      <incoming>SF_S_08</incoming>
      <outgoing>SF_S_09</outgoing>
    </task>
    <task id="Task_DebitCredit" name="Debit Source &#38; Credit Destination">
      <incoming>SF_S_06a</incoming>
      <outgoing>SF_S_08</outgoing>
    </task>
    <task id="Task_QueueNotify" name="Queue Transfer &#38; Notify Director">
      <incoming>SF_S_06b</incoming>
      <outgoing>SF_S_07b</outgoing>
    </task>
    <endEvent id="End_SysQueued" name="Queued">
      <incoming>SF_S_07b</incoming>
    </endEvent>
    <exclusiveGateway id="GW_Online" name="Online?">
      <incoming>SF_S_05</incoming>
      <outgoing>SF_S_06a</outgoing>
      <outgoing>SF_S_06b</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="IntCatch_ReceiveAlloc" name="Receive Allocation Request">
      <outgoing>SF_S_01</outgoing>
      <messageEventDefinition id="MED_ReceiveAlloc" />
    </intermediateCatchEvent>
    <task id="Task_ValidateBPL" name="Validate: Balance, Policy &#38; Limits">
      <incoming>SF_S_01</incoming>
      <outgoing>SF_S_02</outgoing>
    </task>
  </process>
  <process id="Proc_TargetBranch" name="Target Branch / ATM Unit" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveTransfer" name="Receive Fund Transfer">
      <outgoing>SF_B_01</outgoing>
      <messageEventDefinition id="MED_ReceiveTransfer" />
    </intermediateCatchEvent>
    <task id="Task_UpdateLocalBalance" name="Update Local Cash Balance">
      <incoming>SF_B_01</incoming>
      <outgoing>SF_B_02</outgoing>
    </task>
    <task id="Task_AckReceipt" name="Acknowledge Receipt">
      <incoming>SF_B_02</incoming>
      <outgoing>SF_B_03</outgoing>
    </task>
    <endEvent id="End_FundsAvailable" name="Funds Available">
      <incoming>SF_B_03</incoming>
    </endEvent>
    <sequenceFlow id="SF_B_01" sourceRef="IntCatch_ReceiveTransfer" targetRef="Task_UpdateLocalBalance" />
    <sequenceFlow id="SF_B_02" sourceRef="Task_UpdateLocalBalance" targetRef="Task_AckReceipt" />
    <sequenceFlow id="SF_B_03" sourceRef="Task_AckReceipt" targetRef="End_FundsAvailable" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FundAllocation">
    <bpmndi:BPMNPlane id="BPMNPlane_FundAllocation" bpmnElement="Collab_FundAllocation">
      <bpmndi:BPMNShape id="Pool_Director_shape" bpmnElement="Pool_Director" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1840" height="550" />
      </bpmndi:BPMNShape>
