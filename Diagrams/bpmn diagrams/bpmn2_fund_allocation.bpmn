        <bpmndi:BPMNLabel>
          <dc:Bounds x="1079" y="200" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DisplaySummary_shape" bpmnElement="Task_DisplaySummary">
        <dc:Bounds x="1152" y="108" width="155" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataPending_shape" bpmnElement="Task_DataPending">
        <dc:Bounds x="1152" y="200" width="155" height="56" />
