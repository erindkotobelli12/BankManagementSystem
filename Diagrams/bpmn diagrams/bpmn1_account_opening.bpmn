<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AccountOpening" targetNamespace="http://example.com/bpmn/account-opening" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_AccountOpening">
    <participant id="Pool_BankTeller" name="Bank Teller" processRef="Process_BankTeller" />
    <participant id="Pool_Customer" name="Customer" processRef="Process_Customer" />
    <participant id="Pool_BankingSystem" name="Banking System" processRef="Process_BankingSystem" />
    <participant id="Pool_Supervisor" name="Supervisor" processRef="Process_Supervisor" />
    <messageFlow id="MF_IdentityCheck" name="Identity check request" sourceRef="Task_VerifyIdentity" targetRef="IntCatch_PresentDocs" />
    <messageFlow id="MF_KYCSubmitted" name="KYC documents submitted" sourceRef="Task_UploadKYC" targetRef="IntCatch_ReceiveKYC" />
    <messageFlow id="MF_KYCResult" name="KYC validation result" sourceRef="IntThrow_SendKYCResult" targetRef="IntCatch_KYCResult" />
    <messageFlow id="MF_ApprovalRequest" name="Approval request" sourceRef="Task_SubmitApproval" targetRef="IntCatch_ReceiveApproval" />
    <messageFlow id="MF_Decision" name="Approval decision" sourceRef="IntThrow_SendDecision" targetRef="IntCatch_ReceiveDecision" />
    <messageFlow id="MF_CreateCommand" name="Create account command" sourceRef="IntThrow_SendCreateCmd" targetRef="IntCatch_ReceiveCreateCmd" />
  </collaboration>
  <process id="Process_BankTeller" name="Bank Teller" isExecutable="false">
    <startEvent id="Start_TellerStarts" name="Teller Starts Process" />
    <endEvent id="End_AccessDenied" name="Access Denied" />
    <endEvent id="End_IdentityFailed" name="Stop – Identity Failed" />
    <endEvent id="End_KYCRejected" name="KYC Rejected" />
    <endEvent id="End_Rejected" name="Application Rejected" />
    <task id="Task_LoginToSystem" name="Login to System" />
    <task id="Task_SelectOpenAccount" name="Select Open New Account" />
    <task id="Task_EnterCustomerDetails" name="Enter Customer Details" />
    <task id="Task_VerifyIdentity" name="Verify Customer Identity" />
    <task id="Task_UploadKYC" name="Upload KYC Documents" />
    <task id="Task_RejectKYC" name="Reject KYC Documents" />
    <task id="Task_NotifyRejection" name="Notify Customer of Rejection" />
    <exclusiveGateway id="GW_ValidCredentials" name="Valid Credentials?" />
    <exclusiveGateway id="GW_DataComplete" name="Data Complete?" />
    <exclusiveGateway id="GW_IdentityVerified" name="Identity Verified?" />
    <intermediateCatchEvent id="IntCatch_KYCResult" name="Receive KYC&#10;Validation Result">
      <messageEventDefinition id="MED_KYCResult" />
    </intermediateCatchEvent>
    <task id="Task_PromptMissingData" name="Prompt to Complete Missing Data" />
    <endEvent id="End_AccountCreated" name="Account Created" />
    <intermediateThrowEvent id="IntThrow_SendCreateCmd" name="Send Create&#10;Account Command">
      <messageEventDefinition id="MED_SendCreateCmd" />
    </intermediateThrowEvent>
    <exclusiveGateway id="GW_Approved" name="Approved?" />
    <task id="Task_SelectAccountType" name="Select Account Type" />
    <intermediateCatchEvent id="IntCatch_ReceiveDecision" name="Receive Approval&#10;Decision">
      <messageEventDefinition id="MED_ReceiveDecision" />
    </intermediateCatchEvent>
    <task id="Task_SubmitApproval" name="Submit for Supervisor Approval" />
    <exclusiveGateway id="GW_KYCValid" name="KYC Valid?" />
    <sequenceFlow id="SF_Start_Login" sourceRef="Start_TellerStarts" targetRef="Task_LoginToSystem" />
    <sequenceFlow id="SF_GWCred_No" name="No" sourceRef="GW_ValidCredentials" targetRef="End_AccessDenied" />
    <sequenceFlow id="SF_GWIdentity_No" name="No" sourceRef="GW_IdentityVerified" targetRef="End_IdentityFailed" />
    <sequenceFlow id="SF_RejectKYC_End" sourceRef="Task_RejectKYC" targetRef="End_KYCRejected" />
    <sequenceFlow id="SF_Notify_End" sourceRef="Task_NotifyRejection" targetRef="End_Rejected" />
    <sequenceFlow id="SF_Login_GWCred" sourceRef="Task_LoginToSystem" targetRef="GW_ValidCredentials" />
    <sequenceFlow id="SF_GWCred_Yes" name="Yes" sourceRef="GW_ValidCredentials" targetRef="Task_SelectOpenAccount" />
    <sequenceFlow id="SF_Select_Enter" sourceRef="Task_SelectOpenAccount" targetRef="Task_EnterCustomerDetails" />
    <sequenceFlow id="SF_Enter_GWData" sourceRef="Task_EnterCustomerDetails" targetRef="GW_DataComplete" />
    <sequenceFlow id="SF_GWData_Yes" name="Yes" sourceRef="GW_DataComplete" targetRef="Task_VerifyIdentity" />
    <sequenceFlow id="SF_Verify_GWIdentity" sourceRef="Task_VerifyIdentity" targetRef="GW_IdentityVerified" />
    <sequenceFlow id="SF_GWIdentity_Yes" name="Yes" sourceRef="GW_IdentityVerified" targetRef="Task_UploadKYC" />
    <sequenceFlow id="SF_Upload_IntCatch" sourceRef="Task_UploadKYC" targetRef="IntCatch_KYCResult" />
    <sequenceFlow id="SF_GWKYCValid_No" name="No" sourceRef="GW_KYCValid" targetRef="Task_RejectKYC" />
    <sequenceFlow id="SF_GWApproved_No" name="No" sourceRef="GW_Approved" targetRef="Task_NotifyRejection" />
    <sequenceFlow id="SF_Prompt_GWData" sourceRef="Task_PromptMissingData" targetRef="GW_DataComplete" />
    <sequenceFlow id="SF_GWData_No" name="No" sourceRef="GW_DataComplete" targetRef="Task_PromptMissingData" />
    <sequenceFlow id="SF_KYCResult_GW" sourceRef="IntCatch_KYCResult" targetRef="GW_KYCValid" />
    <sequenceFlow id="SF_CreateCmd_End" sourceRef="IntThrow_SendCreateCmd" targetRef="End_AccountCreated" />
    <sequenceFlow id="SF_GWApproved_Yes" name="Yes" sourceRef="GW_Approved" targetRef="IntThrow_SendCreateCmd" />
    <sequenceFlow id="SF_Decision_GWApproved" sourceRef="IntCatch_ReceiveDecision" targetRef="GW_Approved" />
    <sequenceFlow id="SF_GWKYCValid_Yes" name="Yes" sourceRef="GW_KYCValid" targetRef="Task_SelectAccountType" />
    <sequenceFlow id="SF_SelectType_Submit" sourceRef="Task_SelectAccountType" targetRef="Task_SubmitApproval" />
    <sequenceFlow id="SF_Submit_WaitDecision" sourceRef="Task_SubmitApproval" targetRef="IntCatch_ReceiveDecision" />
  </process>
  <process id="Process_Customer" name="Customer" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_PresentDocs" name="Present ID&#10;&#38; Documents">
      <messageEventDefinition id="MED_PresentDocs" />
    </intermediateCatchEvent>
    <task id="Task_ProvideDocuments" name="Provide Identification&#10;&#38; KYC Documents" />
    <endEvent id="End_CustomerDone" name="Documents Submitted" />
    <sequenceFlow id="SF_PresentDocs_Provide" sourceRef="IntCatch_PresentDocs" targetRef="Task_ProvideDocuments" />
    <sequenceFlow id="SF_Provide_Done" sourceRef="Task_ProvideDocuments" targetRef="End_CustomerDone" />
  </process>
  <process id="Process_BankingSystem" name="Banking System" isExecutable="false">
    <task id="Task_ValidateKYC" name="Validate Customer&#10;Data &#38; KYC" />
    <intermediateThrowEvent id="IntThrow_SendKYCResult" name="Send Validation&#10;Result">
      <messageEventDefinition id="MED_SendKYCResult" />
    </intermediateThrowEvent>
    <endEvent id="End_ValidationError" name="Validation Error" />
    <intermediateCatchEvent id="IntCatch_ReceiveCreateCmd" name="Receive Create&#10;Account Command">
      <messageEventDefinition id="MED_ReceiveCreateCmd" />
    </intermediateCatchEvent>
    <task id="Task_CreateAccount" name="Create Account" />
    <task id="Task_GenerateAcctNo" name="Generate&#10;Account Number" />
    <task id="Task_ConfirmCreation" name="Confirm Account&#10;Creation" />
    <endEvent id="End_AccountActive" name="Account Active" />
    <intermediateCatchEvent id="IntCatch_ReceiveKYC" name="Receive KYC&#10;Request">
      <messageEventDefinition id="MED_ReceiveKYC" />
    </intermediateCatchEvent>
    <exclusiveGateway id="GW_DataValid" name="Data Valid?" />
    <sequenceFlow id="SF_ReceiveKYC_Validate" sourceRef="IntCatch_ReceiveKYC" targetRef="Task_ValidateKYC" />
    <sequenceFlow id="SF_Validate_IntThrow" sourceRef="Task_ValidateKYC" targetRef="IntThrow_SendKYCResult" />
    <sequenceFlow id="SF_IntThrow_GW" sourceRef="IntThrow_SendKYCResult" targetRef="GW_DataValid" />
    <sequenceFlow id="SF_GW_ValError" name="Invalid" sourceRef="GW_DataValid" targetRef="End_ValidationError" />
    <sequenceFlow id="SF_GW_WaitCreate" name="Valid" sourceRef="GW_DataValid" targetRef="IntCatch_ReceiveCreateCmd" />
    <sequenceFlow id="SF_CreateCmd_Create" sourceRef="IntCatch_ReceiveCreateCmd" targetRef="Task_CreateAccount" />
    <sequenceFlow id="SF_Create_Generate" sourceRef="Task_CreateAccount" targetRef="Task_GenerateAcctNo" />
    <sequenceFlow id="SF_Generate_Confirm" sourceRef="Task_GenerateAcctNo" targetRef="Task_ConfirmCreation" />
    <sequenceFlow id="SF_Confirm_Active" sourceRef="Task_ConfirmCreation" targetRef="End_AccountActive" />
  </process>
  <process id="Process_Supervisor" name="Supervisor" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveApproval" name="Receive Approval&#10;Request">
      <messageEventDefinition id="MED_ReceiveApproval" />
    </intermediateCatchEvent>
    <task id="Task_ReviewKYC" name="Review Customer&#10;&#38; KYC Documents" />
    <task id="Task_ApproveReject" name="Approve or Reject&#10;Account Opening" />
    <intermediateThrowEvent id="IntThrow_SendDecision" name="Send Approval&#10;Decision">
      <messageEventDefinition id="MED_SendDecision" />
    </intermediateThrowEvent>
    <endEvent id="End_DecisionSent" name="Decision Sent" />
    <sequenceFlow id="SF_ReceiveApproval_Review" sourceRef="IntCatch_ReceiveApproval" targetRef="Task_ReviewKYC" />
    <sequenceFlow id="SF_Review_Decide" sourceRef="Task_ReviewKYC" targetRef="Task_ApproveReject" />
    <sequenceFlow id="SF_Decide_IntThrow" sourceRef="Task_ApproveReject" targetRef="IntThrow_SendDecision" />
    <sequenceFlow id="SF_IntThrow_DecisionEnd" sourceRef="IntThrow_SendDecision" targetRef="End_DecisionSent" />
  </process>
