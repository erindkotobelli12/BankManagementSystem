<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AccountOpening" targetNamespace="http://example.com/bpmn/account-opening" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_AccountOpening">
    <participant id="Pool_BankTeller" name="Bank Teller" processRef="Process_BankTeller" />
    <participant id="Pool_Customer" name="Customer" processRef="Process_Customer" />
    <participant id="Pool_BankingSystem" name="Banking System" processRef="Process_BankingSystem" />
    <participant id="Pool_Supervisor" name="Supervisor" processRef="Process_Supervisor" />
    <messageFlow id="MF_IdentityCheck" name="Identity check" sourceRef="Task_VerifyIdentity" targetRef="IntCatch_PresentDocs" />
    <messageFlow id="MF_KYCSubmitted" name="KYC submitted" sourceRef="Task_UploadKYC" targetRef="IntCatch_ReceiveKYC" />
    <messageFlow id="MF_ApprovalRequest" name="Approval request" sourceRef="Task_SubmitApproval" targetRef="IntCatch_ReceiveApprovalRequest" />
  </collaboration>
  <process id="Process_BankTeller" name="Bank Teller" isExecutable="false">
    <startEvent id="Start_TellerLoggedIn" name="Teller Logged In" />
    <task id="Task_SelectOpenAccount" name="Select Open New Account" />
    <task id="Task_EnterCustomerDetails" name="Enter Customer Details" />
    <task id="Task_VerifyIdentity" name="Verify Customer Identity" />
    <task id="Task_UploadKYC" name="Upload KYC Documents" />
    <task id="Task_SelectAccountType" name="Select Account Type" />
    <task id="Task_SubmitApproval" name="Submit for Approval" />
    <exclusiveGateway id="GW_Approved" name="Approved?" />
    <endEvent id="End_AccountCreated" name="Account Created" />
    <endEvent id="End_Rejected" name="Rejected" />
    <sequenceFlow id="SF_Start_Select" sourceRef="Start_TellerLoggedIn" targetRef="Task_SelectOpenAccount" />
    <sequenceFlow id="SF_Select_Enter" sourceRef="Task_SelectOpenAccount" targetRef="Task_EnterCustomerDetails" />
    <sequenceFlow id="SF_Enter_Verify" sourceRef="Task_EnterCustomerDetails" targetRef="Task_VerifyIdentity" />
    <sequenceFlow id="SF_Verify_Upload" sourceRef="Task_VerifyIdentity" targetRef="Task_UploadKYC" />
    <sequenceFlow id="SF_Upload_SelectType" sourceRef="Task_UploadKYC" targetRef="Task_SelectAccountType" />
    <sequenceFlow id="SF_SelectType_Submit" sourceRef="Task_SelectAccountType" targetRef="Task_SubmitApproval" />
    <sequenceFlow id="SF_Submit_GW" sourceRef="Task_SubmitApproval" targetRef="GW_Approved" />
    <sequenceFlow id="SF_GW_Created" name="Yes" sourceRef="GW_Approved" targetRef="End_AccountCreated" />
    <sequenceFlow id="SF_GW_Rejected" name="No" sourceRef="GW_Approved" targetRef="End_Rejected" />
  </process>
  <process id="Process_Customer" name="Customer" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_PresentDocs" name="Present ID &#38; Docs">
      <messageEventDefinition id="MED_PresentDocs" />
    </intermediateCatchEvent>
    <endEvent id="End_AccountConfirmed" name="Account Confirmed" />
    <endEvent id="Event_064f1h9" name="Rejected" />
    <sequenceFlow id="SF_PresentDocs_Confirmed" sourceRef="IntCatch_PresentDocs" targetRef="End_AccountConfirmed" />
  </process>
  <process id="Process_BankingSystem" name="Banking System" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveKYC" name="Receive KYC Request">
      <messageEventDefinition id="MED_ReceiveKYC" />
    </intermediateCatchEvent>
    <task id="Task_ValidateKYC" name="Validate Customer Data &#38; KYC" />
    <exclusiveGateway id="GW_DataValid" name="Data Valid?" />
    <task id="Task_CreateAccount" name="Create Account &#38; Generate Acct No." />
    <endEvent id="End_AccountActive" name="Account Active" />
    <endEvent id="End_ValidationError" name="Validation Error" />
    <sequenceFlow id="SF_ReceiveKYC_Validate" sourceRef="IntCatch_ReceiveKYC" targetRef="Task_ValidateKYC" />
    <sequenceFlow id="SF_Validate_GW" sourceRef="Task_ValidateKYC" targetRef="GW_DataValid" />
    <sequenceFlow id="SF_GW_CreateAcct" name="Valid" sourceRef="GW_DataValid" targetRef="Task_CreateAccount" />
    <sequenceFlow id="SF_GW_ValError" name="Invalid" sourceRef="GW_DataValid" targetRef="End_ValidationError" />
    <sequenceFlow id="SF_CreateAcct_Active" sourceRef="Task_CreateAccount" targetRef="End_AccountActive" />
  </process>
  <process id="Process_Supervisor" name="Supervisor" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveApprovalRequest" name="Receive Approval Request">
      <messageEventDefinition id="MED_ReceiveApproval" />
    </intermediateCatchEvent>
    <task id="Task_ReviewKYC" name="Review Customer &#38; KYC" />
    <task id="Task_ApproveReject" name="Approve or Reject" />
    <endEvent id="End_DecisionSent" name="Decision Sent" />
    <sequenceFlow id="SF_ReceiveApproval_Review" sourceRef="IntCatch_ReceiveApprovalRequest" targetRef="Task_ReviewKYC" />
    <sequenceFlow id="SF_Review_Decide" sourceRef="Task_ReviewKYC" targetRef="Task_ApproveReject" />
    <sequenceFlow id="SF_Decide_DecisionSent" sourceRef="Task_ApproveReject" targetRef="End_DecisionSent" />
  </process>
