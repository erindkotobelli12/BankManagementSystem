<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FundAllocation" targetNamespace="http://example.com/bpmn/fund-allocation" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_FundAllocation">
    <participant id="Pool_Director" name="Bank Director" processRef="Process_Director" />
    <participant id="Pool_BankingSys" name="Banking System" processRef="Process_BankingSystem" />
    <participant id="Pool_TargetBranch" name="Target Branch / ATM Unit" processRef="Process_TargetBranch" />
    <messageFlow id="MF_AllocationRequest" name="Allocation request" sourceRef="Task_SubmitAllocationRequest" targetRef="IntCatch_ReceiveAllocationRequest" />
    <messageFlow id="MF_ErrorNotice" name="Error" sourceRef="Task_NotifyDirectorError" targetRef="IntCatch_ErrorNotification" />
    <messageFlow id="MF_Confirmed" name="Confirmed" sourceRef="Task_UpdateBalancesConfirm" targetRef="IntCatch_AllocationConfirmed" />
    <messageFlow id="MF_Queued" name="Queued" sourceRef="Task_QueueNotifyDirector" targetRef="IntCatch_QueueNotification" />
    <messageFlow id="MF_FundTransfer" name="Fund transfer" sourceRef="Task_DebitSourceCredit" targetRef="IntCatch_ReceiveFundTransfer" />
  </collaboration>
  <process id="Process_Director" name="Bank Director" isExecutable="false">
    <startEvent id="Start_DirectorAuthenticated" name="Director Authenticated" />
    <task id="Task_NavigateFundAllocation" name="Navigate to Fund Allocation" />
    <task id="Task_ReviewFundBalances" name="Review Fund Balances" />
    <task id="Task_IdentifyUnitsNeedFunds" name="Identify Units Needing Funds" />
    <task id="Task_SelectSourceDest" name="Select Source &#38; Destination" />
    <task id="Task_EnterTransferAmount" name="Enter Transfer Amount">
      <incoming>SF_Retry_Yes</incoming>
    </task>
    <task id="Task_ReviewConfirmDetails" name="Review &#38; Confirm Details" />
    <task id="Task_SubmitAllocationRequest" name="Submit Allocation Request" />
    <eventBasedGateway id="EBG_AwaitResponse" name="Await Response" />
    <intermediateCatchEvent id="IntCatch_AllocationConfirmed" name="Allocation Confirmed">
      <messageEventDefinition id="MED_AllocationConfirmed" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="IntCatch_QueueNotification" name="Queue Notification">
      <messageEventDefinition id="MED_QueueNotification" />
    </intermediateCatchEvent>
    <endEvent id="End_AllocationComplete" name="Allocation Complete" />
    <endEvent id="End_UnitOfflineQueued" name="Unit Offline – Queued" />
    <exclusiveGateway id="GW_Retry" name="Retry?">
      <incoming>SF_Error_GWRetry</incoming>
      <outgoing>SF_Retry_No</outgoing>
      <outgoing>SF_Retry_Yes</outgoing>
    </exclusiveGateway>
    <endEvent id="End_Cancelled" name="Cancelled">
      <incoming>SF_Retry_No</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntCatch_ErrorNotification" name="Error Notification">
      <outgoing>SF_Error_GWRetry</outgoing>
      <messageEventDefinition id="MED_ErrorNotification" />
    </intermediateCatchEvent>
    <sequenceFlow id="SF_Start_Navigate" sourceRef="Start_DirectorAuthenticated" targetRef="Task_NavigateFundAllocation" />
    <sequenceFlow id="SF_Navigate_Review" sourceRef="Task_NavigateFundAllocation" targetRef="Task_ReviewFundBalances" />
    <sequenceFlow id="SF_Review_Identify" sourceRef="Task_ReviewFundBalances" targetRef="Task_IdentifyUnitsNeedFunds" />
    <sequenceFlow id="SF_Identify_Select" sourceRef="Task_IdentifyUnitsNeedFunds" targetRef="Task_SelectSourceDest" />
    <sequenceFlow id="SF_Select_EnterAmount" sourceRef="Task_SelectSourceDest" targetRef="Task_EnterTransferAmount" />
    <sequenceFlow id="SF_Retry_Yes" name="Yes – adjust" sourceRef="GW_Retry" targetRef="Task_EnterTransferAmount" />
    <sequenceFlow id="SF_EnterAmount_Confirm" sourceRef="Task_EnterTransferAmount" targetRef="Task_ReviewConfirmDetails" />
    <sequenceFlow id="SF_Confirm_Submit" sourceRef="Task_ReviewConfirmDetails" targetRef="Task_SubmitAllocationRequest" />
    <sequenceFlow id="SF_Submit_EBG" sourceRef="Task_SubmitAllocationRequest" targetRef="EBG_AwaitResponse" />
    <sequenceFlow id="SF_EBG_Confirmed" name="Confirmed" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_AllocationConfirmed" />
    <sequenceFlow id="SF_EBG_Queued" name="Queued" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_QueueNotification" />
    <sequenceFlow id="SF_EBG_Error" name="Error" sourceRef="EBG_AwaitResponse" targetRef="IntCatch_ErrorNotification" />
    <sequenceFlow id="SF_Confirmed_Complete" sourceRef="IntCatch_AllocationConfirmed" targetRef="End_AllocationComplete" />
    <sequenceFlow id="SF_Queued_Offline" sourceRef="IntCatch_QueueNotification" targetRef="End_UnitOfflineQueued" />
    <sequenceFlow id="SF_Error_GWRetry" sourceRef="IntCatch_ErrorNotification" targetRef="GW_Retry" />
    <sequenceFlow id="SF_Retry_No" name="No" sourceRef="GW_Retry" targetRef="End_Cancelled" />
  </process>
  <process id="Process_BankingSystem" name="Banking System" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveAllocationRequest" name="Receive Allocation Request">
      <messageEventDefinition id="MED_ReceiveAllocation" />
    </intermediateCatchEvent>
    <task id="Task_ValidateBalancePolicyLimits" name="Validate: Balance, Policy &#38; Limits" />
    <exclusiveGateway id="GW_Valid" name="Valid?" />
    <task id="Task_CheckTargetUnitOnline" name="Check Target Unit Online?" />
    <exclusiveGateway id="GW_Online" name="Online?" />
    <task id="Task_NotifyDirectorError" name="Notify Director: Validation Error" />
    <endEvent id="End_AllocationBlocked" name="Allocation Blocked" />
    <task id="Task_DebitSourceCredit" name="Debit Source &#38; Credit Destination" />
    <endEvent id="End_TransferComplete" name="Transfer Complete" />
    <task id="Task_UpdateBalancesConfirm" name="Update Balances &#38; Send Confirmation" />
    <task id="Task_LogAuditTrail" name="Log Audit Trail Entry" />
    <task id="Task_QueueNotifyDirector" name="Queue &#38; Notify Director" />
    <endEvent id="End_Queued" name="Queued" />
    <sequenceFlow id="SF_Sys_ReceiveAlloc_Validate" sourceRef="IntCatch_ReceiveAllocationRequest" targetRef="Task_ValidateBalancePolicyLimits" />
    <sequenceFlow id="SF_Sys_Validate_GWValid" sourceRef="Task_ValidateBalancePolicyLimits" targetRef="GW_Valid" />
    <sequenceFlow id="SF_Sys_GWValid_CheckUnit" name="Valid" sourceRef="GW_Valid" targetRef="Task_CheckTargetUnitOnline" />
    <sequenceFlow id="SF_Sys_GWValid_NotifyError" name="Invalid" sourceRef="GW_Valid" targetRef="Task_NotifyDirectorError" />
    <sequenceFlow id="SF_Sys_CheckUnit_GWOnline" sourceRef="Task_CheckTargetUnitOnline" targetRef="GW_Online" />
    <sequenceFlow id="SF_Sys_GWOnline_Debit" name="Yes" sourceRef="GW_Online" targetRef="Task_DebitSourceCredit" />
    <sequenceFlow id="SF_Sys_GWOnline_Queue" name="No" sourceRef="GW_Online" targetRef="Task_QueueNotifyDirector" />
    <sequenceFlow id="SF_Sys_NotifyError_Blocked" sourceRef="Task_NotifyDirectorError" targetRef="End_AllocationBlocked" />
    <sequenceFlow id="SF_Sys_Debit_Log" sourceRef="Task_DebitSourceCredit" targetRef="Task_LogAuditTrail" />
    <sequenceFlow id="SF_Sys_Update_Complete" sourceRef="Task_UpdateBalancesConfirm" targetRef="End_TransferComplete" />
    <sequenceFlow id="SF_Sys_Log_Update" sourceRef="Task_LogAuditTrail" targetRef="Task_UpdateBalancesConfirm" />
    <sequenceFlow id="SF_Sys_Queue_End" sourceRef="Task_QueueNotifyDirector" targetRef="End_Queued" />
  </process>
  <process id="Process_TargetBranch" name="Target Branch / ATM Unit" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveFundTransfer" name="Receive Fund Transfer">
      <messageEventDefinition id="MED_ReceiveFundTransfer" />
    </intermediateCatchEvent>
    <task id="Task_UpdateLocalCashBalance" name="Update Local Cash Balance" />
    <task id="Task_AcknowledgeReceipt" name="Acknowledge Receipt" />
    <endEvent id="End_FundsAvailable" name="Funds Available" />
    <sequenceFlow id="SF_Branch_Receive_UpdateBalance" sourceRef="IntCatch_ReceiveFundTransfer" targetRef="Task_UpdateLocalCashBalance" />
    <sequenceFlow id="SF_Branch_UpdateBalance_Ack" sourceRef="Task_UpdateLocalCashBalance" targetRef="Task_AcknowledgeReceipt" />
    <sequenceFlow id="SF_Branch_Ack_FundsAvailable" sourceRef="Task_AcknowledgeReceipt" targetRef="End_FundsAvailable" />
  </process>
