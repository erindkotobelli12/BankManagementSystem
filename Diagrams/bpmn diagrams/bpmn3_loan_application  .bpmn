<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LoanApplication" targetNamespace="http://example.com/bpmn/loan-application" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_LoanApplication">
    <participant id="Pool_Customer" name="Customer" processRef="Process_Customer" />
    <participant id="Pool_BankingSys" name="Banking System" processRef="Process_BankingSystem" />
    <participant id="Pool_BankStaff" name="Bank Staff / Loan Officer" processRef="Process_BankStaff" />
    <participant id="Pool_Director" name="Bank Director" processRef="Process_Director" />
    <messageFlow id="MF_AppDocs" name="Application + docs" sourceRef="Task_UploadSupportingDocs" targetRef="IntCatch_SysReceiveApp" />
    <messageFlow id="MF_ValidationError" name="Validation error" sourceRef="End_ValidationFailed" targetRef="IntCatch_ValidationError" />
    <messageFlow id="MF_ValidatedApp" name="Validated application" sourceRef="End_SysForwardToStaff" targetRef="IntCatch_ReceiveApplication" />
    <messageFlow id="MF_HighValueReferral" name="High-value referral" sourceRef="End_StaffDecisionRecorded" targetRef="IntCatch_ReceiveHighValueApp" />
    <messageFlow id="MF_StaffApproval" name="Staff approval" sourceRef="End_StaffApproved" targetRef="IntCatch_SysReceiveApproval" />
    <messageFlow id="MF_StaffRejection" name="Rejection notice" sourceRef="End_StaffRejected" targetRef="IntCatch_AwaitDecision" />
    <messageFlow id="MF_DirectorApproval" name="Director approval" sourceRef="End_ApprovedForwarded" targetRef="IntCatch_SysReceiveApproval" />
    <messageFlow id="MF_DirectorRejection" name="Director rejection" sourceRef="End_HighValueRejected" targetRef="IntCatch_AwaitDecision" />
    <messageFlow id="MF_DecisionDocs" name="Agreement &#38; disbursement notice" sourceRef="Task_SendAgreementNotify" targetRef="IntCatch_AwaitDecision" />
  </collaboration>
  <process id="Process_Customer" name="Customer" isExecutable="false">
    <startEvent id="Start_LoanRequested" name="Loan&#10;Requested" />
    <task id="Task_LoginSystem" name="Login to System" />
    <task id="Task_FillSubmitLoanApp" name="Fill &#38; Submit Loan Application" />
    <task id="Task_UploadSupportingDocs" name="Upload Supporting Documents" />
    <intermediateCatchEvent id="IntCatch_ValidationError" name="Validation Error">
      <messageEventDefinition id="MED_ValidationError" />
    </intermediateCatchEvent>
    <task id="Task_CorrectApplication" name="Correct Application Data" />
    <intermediateCatchEvent id="IntCatch_AwaitDecision" name="Await Decision">
      <messageEventDefinition id="MED_AwaitDecision" />
    </intermediateCatchEvent>
    <exclusiveGateway id="GW_Outcome" name="Outcome?" />
    <task id="Task_SignLoanAgreement" name="Sign Loan Agreement" />
    <task id="Task_SelectRepaymentOption" name="Select Repayment Option" />
    <task id="Task_MakePayment" name="Make Payment (Online or Branch)" />
    <exclusiveGateway id="GW_PaymentSuccessful" name="Payment&#10;Successful?" />
    <endEvent id="End_LoanDisbursed" name="Loan Disbursed" />
    <endEvent id="End_AppRejected" name="Application Rejected" />
    <sequenceFlow id="SF_Cust_Start_Login" sourceRef="Start_LoanRequested" targetRef="Task_LoginSystem" />
    <sequenceFlow id="SF_Cust_Login_Fill" sourceRef="Task_LoginSystem" targetRef="Task_FillSubmitLoanApp" />
    <sequenceFlow id="SF_Cust_Fill_Upload" sourceRef="Task_FillSubmitLoanApp" targetRef="Task_UploadSupportingDocs" />
    <sequenceFlow id="SF_Cust_Upload_Await" sourceRef="Task_UploadSupportingDocs" targetRef="IntCatch_AwaitDecision" />
    <sequenceFlow id="SF_Cust_ValErr_Correct" sourceRef="IntCatch_ValidationError" targetRef="Task_CorrectApplication" />
    <sequenceFlow id="SF_Cust_Correct_Upload" sourceRef="Task_CorrectApplication" targetRef="Task_UploadSupportingDocs" />
    <sequenceFlow id="SF_Cust_Await_GW" sourceRef="IntCatch_AwaitDecision" targetRef="GW_Outcome" />
    <sequenceFlow id="SF_Cust_GW_Sign" name="Approved" sourceRef="GW_Outcome" targetRef="Task_SignLoanAgreement" />
    <sequenceFlow id="SF_Cust_GW_Rejected" name="Rejected" sourceRef="GW_Outcome" targetRef="End_AppRejected" />
    <sequenceFlow id="SF_Cust_Sign_Disbursed" sourceRef="Task_SignLoanAgreement" targetRef="End_LoanDisbursed" />
    <sequenceFlow id="SF_Cust_Disburse_Repay" sourceRef="End_LoanDisbursed" targetRef="Task_SelectRepaymentOption" />
    <sequenceFlow id="SF_Cust_Repay_Make" sourceRef="Task_SelectRepaymentOption" targetRef="Task_MakePayment" />
    <sequenceFlow id="SF_Cust_Make_GWPay" sourceRef="Task_MakePayment" targetRef="GW_PaymentSuccessful" />
    <sequenceFlow id="SF_Cust_Pay_Success" name="Yes" sourceRef="GW_PaymentSuccessful" targetRef="Task_ViewUpdatedBalance" />
    <sequenceFlow id="SF_Cust_Pay_Retry" name="No" sourceRef="GW_PaymentSuccessful" targetRef="Task_RetryPayment" />
    <sequenceFlow id="SF_Cust_Retry_Make" sourceRef="Task_RetryPayment" targetRef="Task_MakePayment" />
    <sequenceFlow id="SF_Cust_Balance_Done" sourceRef="Task_ViewUpdatedBalance" targetRef="End_RepaymentDone" />
    <task id="Task_ViewUpdatedBalance" name="View Updated Balance &#38; Amortization Schedule" />
    <endEvent id="End_RepaymentDone" name="Repayment Confirmed" />
    <task id="Task_RetryPayment" name="Retry Payment" />
  </process>
  <process id="Process_BankingSystem" name="Banking System" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_SysReceiveApp" name="Receive Application">
      <messageEventDefinition id="MED_SysReceiveApp" />
    </intermediateCatchEvent>
    <task id="Task_ValidateApplication" name="Validate Application Data" />
    <exclusiveGateway id="GW_AppValid" name="Application&#10;Valid?" />
    <endEvent id="End_ValidationFailed" name="Validation Error Sent">
      <messageEventDefinition id="MED_ValidationFailed" />
    </endEvent>
    <intermediateCatchEvent id="IntCatch_SysReceiveApproval" name="Receive Approval">
      <messageEventDefinition id="MED_SysReceiveApproval" />
    </intermediateCatchEvent>
    <task id="Task_ValidateApprovalLimits" name="Validate Approval &#38; Limits" />
    <task id="Task_CreateLoanAccount" name="Create Loan Account &#38; Amortization Schedule" />
    <task id="Task_DisburseFunds" name="Disburse Funds to Customer" />
    <task id="Task_SendAgreementNotify" name="Send Agreement &#38; Notify Customer" />
    <endEvent id="End_DisbursementComplete" name="Disbursement&#10;Complete" />
    <sequenceFlow id="SF_Sys_Receive_Validate" sourceRef="IntCatch_SysReceiveApp" targetRef="Task_ValidateApplication" />
    <sequenceFlow id="SF_Sys_Validate_GW" sourceRef="Task_ValidateApplication" targetRef="GW_AppValid" />
    <sequenceFlow id="SF_Sys_GW_Invalid" name="No" sourceRef="GW_AppValid" targetRef="End_ValidationFailed" />
    <sequenceFlow id="SF_Sys_GW_Valid" name="Yes" sourceRef="GW_AppValid" targetRef="End_SysForwardToStaff" />
    <sequenceFlow id="SF_Sys_Approval_Validate" sourceRef="IntCatch_SysReceiveApproval" targetRef="Task_ValidateApprovalLimits" />
    <sequenceFlow id="SF_Sys_Validate_Create" sourceRef="Task_ValidateApprovalLimits" targetRef="Task_CreateLoanAccount" />
    <sequenceFlow id="SF_Sys_Create_Disburse" sourceRef="Task_CreateLoanAccount" targetRef="Task_DisburseFunds" />
    <sequenceFlow id="SF_Sys_Disburse_Notify" sourceRef="Task_DisburseFunds" targetRef="Task_SendAgreementNotify" />
    <sequenceFlow id="SF_Sys_Notify_Complete" sourceRef="Task_SendAgreementNotify" targetRef="End_DisbursementComplete" />
    <endEvent id="End_SysForwardToStaff" name="Application&#10;Forwarded to Staff">
      <messageEventDefinition id="MED_ForwardToStaff" />
    </endEvent>
  </process>
  <process id="Process_BankStaff" name="Bank Staff / Loan Officer" isExecutable="false">
    <intermediateCatchEvent id="IntCatch_ReceiveApplication" name="Receive Application">
      <messageEventDefinition id="MED_ReceiveApplication" />
    </intermediateCatchEvent>
    <task id="Task_ReviewAppDocs" name="Review Application &#38; Documents" />
    <task id="Task_RunCreditScore" name="Run Credit Score Check" />
    <exclusiveGateway id="GW_DocsComplete" name="Docs&#10;Complete?" />
    <task id="Task_RequestMoreDocs" name="Request More Documents" />
    <task id="Task_AssessLoanRisk" name="Assess Loan Risk &#38; Recommend" />
    <exclusiveGateway id="GW_HighValue" name="High-Value&#10;&#62; Threshold?" />
    <task id="Task_StaffApproveReject" name="Staff: Approve or Reject Loan" />
    <endEvent id="End_StaffRejected" name="Staff Rejected&#10;– Customer Notified">
      <messageEventDefinition id="MED_StaffRejected" />
    </endEvent>
    <sequenceFlow id="SF_Staff_Receive_Review" sourceRef="IntCatch_ReceiveApplication" targetRef="Task_ReviewAppDocs" />
    <sequenceFlow id="SF_Staff_Review_Credit" sourceRef="Task_ReviewAppDocs" targetRef="Task_RunCreditScore" />
    <sequenceFlow id="SF_Staff_Credit_GWDocs" sourceRef="Task_RunCreditScore" targetRef="GW_DocsComplete" />
    <sequenceFlow id="SF_Staff_GWDocs_Assess" name="Yes" sourceRef="GW_DocsComplete" targetRef="Task_AssessLoanRisk" />
    <sequenceFlow id="SF_Staff_GWDocs_MoreDocs" name="No" sourceRef="GW_DocsComplete" targetRef="Task_RequestMoreDocs" />
    <sequenceFlow id="SF_Staff_MoreDocs_Review" sourceRef="Task_RequestMoreDocs" targetRef="Task_ReviewAppDocs" />
    <sequenceFlow id="SF_Staff_Assess_GWHighVal" sourceRef="Task_AssessLoanRisk" targetRef="GW_HighValue" />
    <sequenceFlow id="SF_Staff_GWHighVal_Approve" name="No" sourceRef="GW_HighValue" targetRef="Task_StaffApproveReject" />
    <sequenceFlow id="SF_Staff_GWHighVal_Director" name="Yes" sourceRef="GW_HighValue" targetRef="End_StaffDecisionRecorded" />
    <sequenceFlow id="SF_Staff_Approve_Approved" sourceRef="Task_StaffApproveReject" targetRef="End_StaffApproved">
      <conditionExpression>approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SF_Staff_Approve_Rejected" sourceRef="Task_StaffApproveReject" targetRef="End_StaffRejected">
      <conditionExpression>rejected</conditionExpression>
    </sequenceFlow>
    <endEvent id="End_StaffDecisionRecorded" name="High-Value Referral&#10;Sent to Director">
      <messageEventDefinition id="MED_StaffHighValue" />
    </endEvent>
    <endEvent id="End_StaffApproved" name="Staff Approved&#10;– Forwarded">
      <messageEventDefinition id="MED_StaffApproved" />
    </endEvent>
  </process>
  <process id="Process_Director" name="Bank Director" isExecutable="false">
    <sequenceFlow id="SF_Dir_Receive_Review" sourceRef="IntCatch_ReceiveHighValueApp" targetRef="Task_ReviewRiskCredit" />
    <sequenceFlow id="SF_Dir_Review_Assess" sourceRef="Task_ReviewRiskCredit" targetRef="Task_AssessCollateral" />
    <sequenceFlow id="SF_Dir_Assess_GWDecision" sourceRef="Task_AssessCollateral" targetRef="GW_DirectorDecision" />
    <sequenceFlow id="SF_Dir_GW_Approve" name="Approved" sourceRef="GW_DirectorDecision" targetRef="Task_IssueConditionalApproval" />
    <sequenceFlow id="SF_Dir_GW_Reject" name="Rejected" sourceRef="GW_DirectorDecision" targetRef="End_HighValueRejected" />
    <sequenceFlow id="SF_Dir_Approve_Forwarded" sourceRef="Task_IssueConditionalApproval" targetRef="End_ApprovedForwarded" />
    <intermediateCatchEvent id="IntCatch_ReceiveHighValueApp" name="Receive High-Value&#10;Application">
      <messageEventDefinition id="MED_ReceiveHighValue" />
    </intermediateCatchEvent>
    <task id="Task_ReviewRiskCredit" name="Review Risk Report &#38; Credit Score" />
    <task id="Task_AssessCollateral" name="Assess Collateral &#38; Viability" />
    <exclusiveGateway id="GW_DirectorDecision" name="Director&#10;Decision?" />
    <endEvent id="End_HighValueRejected" name="High-Value&#10;Rejected">
      <messageEventDefinition id="MED_DirRejected" />
    </endEvent>
    <task id="Task_IssueConditionalApproval" name="Issue Conditional Approval" />
    <endEvent id="End_ApprovedForwarded" name="Approved &#38;&#10;Forwarded">
      <messageEventDefinition id="MED_DirApproved" />
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApplication">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApplication" bpmnElement="Collaboration_LoanApplication">
      <bpmndi:BPMNShape id="Shape_Pool_Customer" bpmnElement="Pool_Customer" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1720" height="200" />
      </bpmndi:BPMNShape>
