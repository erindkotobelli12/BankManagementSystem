        <dc:Bounds x="1025" y="220" width="30" height="30" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1053" y="216" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ViewBalance" bpmnElement="Task_ViewUpdatedBalance">
