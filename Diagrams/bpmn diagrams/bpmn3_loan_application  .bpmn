      <bpmndi:BPMNShape id="Shape_Pool_BankingSys" bpmnElement="Pool_BankingSys" isHorizontal="true">
        <dc:Bounds x="150" y="290" width="1720" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_IntCatch_SysReceiveApp" bpmnElement="IntCatch_SysReceiveApp">
        <dc:Bounds x="545" y="377" width="26" height="26" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="408" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateApp" bpmnElement="Task_ValidateApplication">
        <dc:Bounds x="591" y="362" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_AppValid" bpmnElement="GW_AppValid" isMarkerVisible="true">
        <dc:Bounds x="741" y="374" width="32" height="32" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="783" y="376" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ValidationFailed" bpmnElement="End_ValidationFailed">
        <dc:Bounds x="793" y="420" width="30" height="30" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="764" y="455" width="88" height="27" />
