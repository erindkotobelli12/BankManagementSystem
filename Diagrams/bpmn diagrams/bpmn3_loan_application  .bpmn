      <bpmndi:BPMNShape id="Shape_Task_SelectRepay" bpmnElement="Task_SelectRepaymentOption">
        <dc:Bounds x="1270" y="110" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MakePayment" bpmnElement="Task_MakePayment">
